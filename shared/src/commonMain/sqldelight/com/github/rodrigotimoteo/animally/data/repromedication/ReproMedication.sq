-- CRUD Operations --
insert:
INSERT INTO ReproMedication (id, patientId, medication, dateAdministered, dosage, purpose, vetName, notes, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE ReproMedication SET
    patientId = ?,
    medication = ?,
    dateAdministered = ?,
    dosage = ?,
    purpose = ?,
    vetName = ?,
    notes = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM ReproMedication WHERE id = ?;

selectById:
SELECT * FROM ReproMedication WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM ReproMedication WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM ReproMedication WHERE isActive = 1;

setInactive:
UPDATE ReproMedication SET isActive = 0, updatedAt = ? WHERE id = ?;