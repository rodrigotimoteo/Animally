-- CRUD Operations --
insert:
INSERT INTO Follicle (id, ultrasoundId, side, sizeMm, description, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?);


update:
UPDATE Follicle SET
    ultrasoundId = ?,
    side = ?,
    sizeMm = ?,
    description = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Follicle WHERE id = ?;

selectById:
SELECT * FROM Follicle WHERE id = ? AND isActive = 1;

selectByUltrasound:
SELECT * FROM Follicle WHERE ultrasoundId = ? AND isActive = 1;

selectAll:
SELECT * FROM Follicle WHERE isActive = 1;

setInactive:
UPDATE Follicle SET isActive = 0, updatedAt = ? WHERE id = ?;

-- Backup support --
deleteAll:
DELETE FROM Follicle;

selectAllRows:
SELECT * FROM Follicle;

insertWithId:
INSERT INTO Follicle (id, ultrasoundId, side, sizeMm, description, isActive, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

-- Sync support
selectByServerId:
SELECT * FROM Follicle WHERE serverId = ?;

selectChangedSince:
SELECT * FROM Follicle WHERE updatedAt > ?;

setServerId:
UPDATE Follicle SET serverId = ?, updatedAt = ? WHERE id = ?;

-- Sync support: unfiltered row read (pull must see soft-deleted rows)
selectRowById:
SELECT * FROM Follicle WHERE id = ?;
