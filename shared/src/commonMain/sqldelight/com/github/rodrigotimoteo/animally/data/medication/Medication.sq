-- CRUD Operations --
insert:
INSERT INTO Medication (id, patientId, name, dosage, route, frequency, startDate, endDate, prescribedBy, notes, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Medication SET
    patientId = ?,
    name = ?,
    dosage = ?,
    route = ?,
    frequency = ?,
    startDate = ?,
    endDate = ?,
    prescribedBy = ?,
    notes = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Medication WHERE id = ?;

selectById:
SELECT * FROM Medication WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM Medication WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM Medication WHERE isActive = 1;

setInactive:
UPDATE Medication SET isActive = 0, updatedAt = ? WHERE id = ?;
countActiveByPatient:
SELECT COUNT(*) FROM Medication WHERE patientId = ? AND isActive = 1;

-- Backup support --
deleteAll:
DELETE FROM Medication;

selectAllRows:
SELECT * FROM Medication;

insertWithId:
INSERT INTO Medication (id, patientId, name, dosage, route, frequency, startDate, endDate, prescribedBy, notes, isActive, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Sync support --
selectByServerId:
SELECT * FROM Medication WHERE serverId = ? AND isActive = 1;

selectChangedSince:
SELECT * FROM Medication WHERE updatedAt > ?;

setServerId:
UPDATE Medication SET serverId = ?, updatedAt = ? WHERE id = ?;
