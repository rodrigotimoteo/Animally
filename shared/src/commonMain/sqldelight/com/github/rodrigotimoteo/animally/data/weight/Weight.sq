-- CRUD Operations --
insert:
INSERT INTO Weight (id, patientId, weightKg, date, notes, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Weight SET
    patientId = ?,
    weightKg = ?,
    date = ?,
    notes = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Weight WHERE id = ?;

selectById:
SELECT * FROM Weight WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM Weight WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM Weight WHERE isActive = 1;

setInactive:
UPDATE Weight SET isActive = 0 WHERE id = ?;