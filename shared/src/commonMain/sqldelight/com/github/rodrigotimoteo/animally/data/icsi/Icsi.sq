-- CRUD Operations --
insert:
INSERT INTO Icsi (id, patientId, date, folliclesRecovered, vetName, notes, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?);


update:
UPDATE Icsi SET
    patientId = ?,
    date = ?,
    folliclesRecovered = ?,
    vetName = ?,
    notes = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Icsi WHERE id = ?;

selectById:
SELECT * FROM Icsi WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM Icsi WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM Icsi WHERE isActive = 1;

setInactive:
UPDATE Icsi SET isActive = 0, updatedAt = ? WHERE id = ?;

countActiveByPatient:
SELECT COUNT(*) FROM Icsi WHERE patientId = ? AND isActive = 1;

-- Backup support --
deleteAll:
DELETE FROM Icsi;

selectAllRows:
SELECT * FROM Icsi;

insertWithId:
INSERT INTO Icsi (id, patientId, date, folliclesRecovered, vetName, notes, isActive, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectByServerId:
SELECT * FROM Icsi WHERE serverId = ?;

selectChangedSince:
SELECT * FROM Icsi WHERE updatedAt > ? AND isActive = 1;

setServerId:
UPDATE Icsi SET serverId = ?, updatedAt = ? WHERE id = ?;
