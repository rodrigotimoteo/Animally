-- SQL Table --
CREATE TABLE Reproduction (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    patientId INTEGER NOT NULL,
    eventType TEXT NOT NULL,
    date TEXT NOT NULL,
    details TEXT,
    vetName TEXT,
    notes TEXT,
    isActive INTEGER NOT NULL DEFAULT 1,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

-- CRUD Operations --
insert:
INSERT INTO Reproduction (id, patientId, eventType, date, details, vetName, notes, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Reproduction SET
    patientId = ?,
    eventType = ?,
    date = ?,
    details = ?,
    vetName = ?,
    notes = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Reproduction WHERE id = ?;

selectById:
SELECT * FROM Reproduction WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM Reproduction WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM Reproduction WHERE isActive = 1;

setInactive:
UPDATE Reproduction SET isActive = 0, updatedAt = ? WHERE id = ?;