-- CRUD Operations --
insert:
INSERT INTO FarrierVisit (id, patientId, date, trimOrShoe, shoeType, findings, nextDueDate, farrier, notes, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);


update:
UPDATE FarrierVisit SET
    patientId = ?,
    date = ?,
    trimOrShoe = ?,
    shoeType = ?,
    findings = ?,
    nextDueDate = ?,
    farrier = ?,
    notes = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM FarrierVisit WHERE id = ?;

selectById:
SELECT * FROM FarrierVisit WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM FarrierVisit WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM FarrierVisit WHERE isActive = 1;

setInactive:
UPDATE FarrierVisit SET isActive = 0, updatedAt = ? WHERE id = ?;
countActiveByPatient:
SELECT COUNT(*) FROM FarrierVisit WHERE patientId = ? AND isActive = 1;

-- Backup support --
deleteAll:
DELETE FROM FarrierVisit;

selectAllRows:
SELECT * FROM FarrierVisit;

insertWithId:
INSERT INTO FarrierVisit (id, patientId, date, trimOrShoe, shoeType, findings, nextDueDate, farrier, notes, isActive, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Sync support --
selectByServerId:
SELECT * FROM FarrierVisit WHERE serverId = ? AND isActive = 1;

selectChangedSince:
SELECT * FROM FarrierVisit WHERE updatedAt > ?;

setServerId:
UPDATE FarrierVisit SET serverId = ?, updatedAt = ? WHERE id = ?;
