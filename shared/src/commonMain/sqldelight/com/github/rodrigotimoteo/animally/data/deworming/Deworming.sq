-- SQL Table --
CREATE TABLE Deworming (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    patientId INTEGER NOT NULL,
    product TEXT NOT NULL,
    dateAdministered TEXT NOT NULL,
    nextDueDate TEXT,
    dose TEXT,
    vetName TEXT,
    notes TEXT,
    isActive INTEGER NOT NULL DEFAULT 1,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

-- CRUD Operations --
insert:
INSERT INTO Deworming (id, patientId, product, dateAdministered, nextDueDate, dose, vetName, notes, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Deworming SET
    patientId = ?,
    product = ?,
    dateAdministered = ?,
    nextDueDate = ?,
    dose = ?,
    vetName = ?,
    notes = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Deworming WHERE id = ?;

selectById:
SELECT * FROM Deworming WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM Deworming WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM Deworming WHERE isActive = 1;

setInactive:
UPDATE Deworming SET isActive = 0, updatedAt = ? WHERE id = ?;