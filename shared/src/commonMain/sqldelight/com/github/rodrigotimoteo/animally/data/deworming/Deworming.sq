-- CRUD Operations --
insert:
INSERT INTO Deworming (id, patientId, product, dateAdministered, nextDueDate, dose, vetName, notes, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Deworming SET
    patientId = ?,
    product = ?,
    dateAdministered = ?,
    nextDueDate = ?,
    dose = ?,
    vetName = ?,
    notes = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Deworming WHERE id = ?;

selectById:
SELECT * FROM Deworming WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM Deworming WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM Deworming WHERE isActive = 1;

setInactive:
UPDATE Deworming SET isActive = 0, updatedAt = ? WHERE id = ?;
countActiveByPatient:
SELECT COUNT(*) FROM Deworming WHERE patientId = ? AND isActive = 1;

-- Backup support --
deleteAll:
DELETE FROM Deworming;

selectAllRows:
SELECT * FROM Deworming;

insertWithId:
INSERT INTO Deworming (id, patientId, product, dateAdministered, nextDueDate, dose, vetName, notes, isActive, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Sync support --
selectByServerId:
SELECT * FROM Deworming WHERE serverId = ? AND isActive = 1;

selectChangedSince:
SELECT * FROM Deworming WHERE updatedAt > ?;

setServerId:
UPDATE Deworming SET serverId = ?, updatedAt = ? WHERE id = ?;
