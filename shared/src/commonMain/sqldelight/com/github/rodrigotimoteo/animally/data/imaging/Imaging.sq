-- CRUD Operations --
insert:
INSERT INTO Imaging (id, patientId, type, date, findings, imageUris, vetName, notes, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Imaging SET
    patientId = ?,
    type = ?,
    date = ?,
    findings = ?,
    imageUris = ?,
    vetName = ?,
    notes = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Imaging WHERE id = ?;

selectById:
SELECT * FROM Imaging WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM Imaging WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM Imaging WHERE isActive = 1;

setInactive:
UPDATE Imaging SET isActive = 0, updatedAt = ? WHERE id = ?;
countActiveByPatient:
SELECT COUNT(*) FROM Imaging WHERE patientId = ? AND isActive = 1;
