-- CRUD Operations --
insert:
INSERT INTO Imaging (id, patientId, type, date, findings, imageUris, vetName, notes, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);


update:
UPDATE Imaging SET
    patientId = ?,
    type = ?,
    date = ?,
    findings = ?,
    imageUris = ?,
    vetName = ?,
    notes = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Imaging WHERE id = ?;

selectById:
SELECT * FROM Imaging WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM Imaging WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM Imaging WHERE isActive = 1;

setInactive:
UPDATE Imaging SET isActive = 0, updatedAt = ? WHERE id = ?;
countActiveByPatient:
SELECT COUNT(*) FROM Imaging WHERE patientId = ? AND isActive = 1;

-- Backup support --
deleteAll:
DELETE FROM Imaging;

selectAllRows:
SELECT * FROM Imaging;

insertWithId:
INSERT INTO Imaging (id, patientId, type, date, findings, imageUris, vetName, notes, isActive, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Sync support --
selectByServerId:
SELECT * FROM Imaging WHERE serverId = ? AND isActive = 1;

selectChangedSince:
SELECT * FROM Imaging WHERE updatedAt > ?;

setServerId:
UPDATE Imaging SET serverId = ?, updatedAt = ? WHERE id = ?;
