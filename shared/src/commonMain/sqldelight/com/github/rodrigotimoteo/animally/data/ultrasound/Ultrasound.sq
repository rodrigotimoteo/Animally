-- CRUD Operations --
insert:
INSERT INTO Ultrasound (id, patientId, date, ovaryStatus, uterineStatus, follicleSizeMm, leftOvaryStatus, rightOvaryStatus, leftFollicleSizeMm, rightFollicleSizeMm, uterineEdema, uterineLiquid, uterineLiquidDescription, uterusDescription, findings, imageUris, vetName, notes, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);


update:
UPDATE Ultrasound SET
    patientId = ?,
    date = ?,
    ovaryStatus = ?,
    uterineStatus = ?,
    follicleSizeMm = ?,
    leftOvaryStatus = ?,
    rightOvaryStatus = ?,
    leftFollicleSizeMm = ?,
    rightFollicleSizeMm = ?,
    uterineEdema = ?,
    uterineLiquid = ?,
    uterineLiquidDescription = ?,
    uterusDescription = ?,
    findings = ?,
    imageUris = ?,
    vetName = ?,
    notes = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Ultrasound WHERE id = ?;

selectById:
SELECT * FROM Ultrasound WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM Ultrasound WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM Ultrasound WHERE isActive = 1;

setInactive:
UPDATE Ultrasound SET isActive = 0, updatedAt = ? WHERE id = ?;
countActiveByPatient:
SELECT COUNT(*) FROM Ultrasound WHERE patientId = ? AND isActive = 1;

-- Backup support --
deleteAll:
DELETE FROM Ultrasound;

selectAllRows:
SELECT * FROM Ultrasound;

insertWithId:
INSERT INTO Ultrasound (id, patientId, date, ovaryStatus, uterineStatus, follicleSizeMm, findings, imageUris, vetName, notes, isActive, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Sync support --
selectByServerId:
SELECT * FROM Ultrasound WHERE serverId = ? AND isActive = 1;

selectChangedSince:
SELECT * FROM Ultrasound WHERE updatedAt > ?;

setServerId:
UPDATE Ultrasound SET serverId = ?, updatedAt = ? WHERE id = ?;
