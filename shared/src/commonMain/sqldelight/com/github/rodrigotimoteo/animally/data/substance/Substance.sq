-- CRUD Operations --
insert:
INSERT INTO Substance (id, patientId, drugName, dose, unit, route, administeredBy, witness, date, reason, notes, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Substance SET
    patientId = ?,
    drugName = ?,
    dose = ?,
    unit = ?,
    route = ?,
    administeredBy = ?,
    witness = ?,
    date = ?,
    reason = ?,
    notes = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Substance WHERE id = ?;

selectById:
SELECT * FROM Substance WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM Substance WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM Substance WHERE isActive = 1;

setInactive:
UPDATE Substance SET isActive = 0, updatedAt = ? WHERE id = ?;
countActiveByPatient:
SELECT COUNT(*) FROM Substance WHERE patientId = ? AND isActive = 1;

-- Backup support --
deleteAll:
DELETE FROM Substance;

selectAllRows:
SELECT * FROM Substance;

insertWithId:
INSERT INTO Substance (id, patientId, drugName, dose, unit, route, administeredBy, witness, date, reason, notes, isActive, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Sync support --
selectByServerId:
SELECT * FROM Substance WHERE serverId = ? AND isActive = 1;

selectChangedSince:
SELECT * FROM Substance WHERE updatedAt > ?;

setServerId:
UPDATE Substance SET serverId = ?, updatedAt = ? WHERE id = ?;
