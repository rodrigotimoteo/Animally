-- CRUD Operations --
insert:
INSERT INTO LabResult (id, patientId, testType, date, results, normalRange, vetName, notes, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE LabResult SET
    patientId = ?,
    testType = ?,
    date = ?,
    results = ?,
    normalRange = ?,
    vetName = ?,
    notes = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM LabResult WHERE id = ?;

selectById:
SELECT * FROM LabResult WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM LabResult WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM LabResult WHERE isActive = 1;

setInactive:
UPDATE LabResult SET isActive = 0, updatedAt = ? WHERE id = ?;