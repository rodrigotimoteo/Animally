-- CRUD Operations --
insert:
INSERT INTO LabResult (id, patientId, testType, date, results, normalRange, vetName, notes, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE LabResult SET
    patientId = ?,
    testType = ?,
    date = ?,
    results = ?,
    normalRange = ?,
    vetName = ?,
    notes = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM LabResult WHERE id = ?;

selectById:
SELECT * FROM LabResult WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM LabResult WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM LabResult WHERE isActive = 1;

setInactive:
UPDATE LabResult SET isActive = 0, updatedAt = ? WHERE id = ?;
countActiveByPatient:
SELECT COUNT(*) FROM LabResult WHERE patientId = ? AND isActive = 1;

-- Backup support --
deleteAll:
DELETE FROM LabResult;

selectAllRows:
SELECT * FROM LabResult;

insertWithId:
INSERT INTO LabResult (id, patientId, testType, date, results, normalRange, vetName, notes, isActive, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Sync support --
selectByServerId:
SELECT * FROM LabResult WHERE serverId = ? AND isActive = 1;

selectChangedSince:
SELECT * FROM LabResult WHERE updatedAt > ?;

setServerId:
UPDATE LabResult SET serverId = ?, updatedAt = ? WHERE id = ?;
