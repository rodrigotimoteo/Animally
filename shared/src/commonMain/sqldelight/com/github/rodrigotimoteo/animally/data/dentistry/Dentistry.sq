-- CRUD Operations --
insert:
INSERT INTO Dentistry (id, patientId, date, findings, treatment, nextDueDate, vetName, notes, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Dentistry SET
    patientId = ?,
    date = ?,
    findings = ?,
    treatment = ?,
    nextDueDate = ?,
    vetName = ?,
    notes = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Dentistry WHERE id = ?;

selectById:
SELECT * FROM Dentistry WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM Dentistry WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM Dentistry WHERE isActive = 1;

setInactive:
UPDATE Dentistry SET isActive = 0, updatedAt = ? WHERE id = ?;
countActiveByPatient:
SELECT COUNT(*) FROM Dentistry WHERE patientId = ? AND isActive = 1;

-- Backup support --
deleteAll:
DELETE FROM Dentistry;

selectAllRows:
SELECT * FROM Dentistry;

insertWithId:
INSERT INTO Dentistry (id, patientId, date, findings, treatment, nextDueDate, vetName, notes, isActive, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Sync support --
selectByServerId:
SELECT * FROM Dentistry WHERE serverId = ? AND isActive = 1;

selectChangedSince:
SELECT * FROM Dentistry WHERE updatedAt > ?;

setServerId:
UPDATE Dentistry SET serverId = ?, updatedAt = ? WHERE id = ?;
