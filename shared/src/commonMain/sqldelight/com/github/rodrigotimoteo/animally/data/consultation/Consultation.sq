-- SQL Table --
CREATE TABLE Consultation (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    patientId INTEGER NOT NULL,
    date TEXT NOT NULL,
    subjective TEXT,
    objective TEXT,
    assessment TEXT,
    plan TEXT,
    vetName TEXT,
    nextVisitDate TEXT,
    isActive INTEGER NOT NULL DEFAULT 1,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

-- CRUD Operations --
insert:
INSERT INTO Consultation (id, patientId, date, subjective, objective, assessment, plan, vetName, nextVisitDate, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Consultation SET
    patientId = ?,
    date = ?,
    subjective = ?,
    objective = ?,
    assessment = ?,
    plan = ?,
    vetName = ?,
    nextVisitDate = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Consultation WHERE id = ?;

selectById:
SELECT * FROM Consultation WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM Consultation WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM Consultation WHERE isActive = 1;

setInactive:
UPDATE Consultation SET isActive = 0, updatedAt = ? WHERE id = ?;