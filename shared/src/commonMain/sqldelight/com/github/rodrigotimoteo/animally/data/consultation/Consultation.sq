-- CRUD Operations --
insert:
INSERT INTO Consultation (id, patientId, date, subjective, objective, assessment, plan, vetName, nextVisitDate, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);


update:
UPDATE Consultation SET
    patientId = ?,
    date = ?,
    subjective = ?,
    objective = ?,
    assessment = ?,
    plan = ?,
    vetName = ?,
    nextVisitDate = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Consultation WHERE id = ?;

selectById:
SELECT * FROM Consultation WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM Consultation WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM Consultation WHERE isActive = 1;

setInactive:
UPDATE Consultation SET isActive = 0, updatedAt = ? WHERE id = ?;
countActiveByPatient:
SELECT COUNT(*) FROM Consultation WHERE patientId = ? AND isActive = 1;

-- Backup support --
deleteAll:
DELETE FROM Consultation;

selectAllRows:
SELECT * FROM Consultation;

insertWithId:
INSERT INTO Consultation (id, patientId, date, subjective, objective, assessment, plan, vetName, nextVisitDate, isActive, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Sync support --
selectByServerId:
SELECT * FROM Consultation WHERE serverId = ? AND isActive = 1;

selectChangedSince:
SELECT * FROM Consultation WHERE updatedAt > ?;

setServerId:
UPDATE Consultation SET serverId = ?, updatedAt = ? WHERE id = ?;
