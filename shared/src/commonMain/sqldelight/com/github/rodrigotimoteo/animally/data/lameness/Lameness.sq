-- CRUD Operations --
insert:
INSERT INTO Lameness (id, patientId, date, gradeAAEP, limbLocation, flexionTest, diagnosis, treatment, vetName, notes, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Lameness SET
    patientId = ?,
    date = ?,
    gradeAAEP = ?,
    limbLocation = ?,
    flexionTest = ?,
    diagnosis = ?,
    treatment = ?,
    vetName = ?,
    notes = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Lameness WHERE id = ?;

selectById:
SELECT * FROM Lameness WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM Lameness WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM Lameness WHERE isActive = 1;

setInactive:
UPDATE Lameness SET isActive = 0, updatedAt = ? WHERE id = ?;
countActiveByPatient:
SELECT COUNT(*) FROM Lameness WHERE patientId = ? AND isActive = 1;

-- Backup support --
deleteAll:
DELETE FROM Lameness;

selectAllRows:
SELECT * FROM Lameness;

insertWithId:
INSERT INTO Lameness (id, patientId, date, gradeAAEP, limbLocation, flexionTest, diagnosis, treatment, vetName, notes, isActive, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Sync support --
selectByServerId:
SELECT * FROM Lameness WHERE serverId = ? AND isActive = 1;

selectChangedSince:
SELECT * FROM Lameness WHERE updatedAt > ?;

setServerId:
UPDATE Lameness SET serverId = ?, updatedAt = ? WHERE id = ?;
