-- SQL Table --
CREATE TABLE Lameness (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    patientId INTEGER NOT NULL,
    date TEXT NOT NULL,
    gradeAAEP INTEGER,
    limbLocation TEXT,
    flexionTest TEXT,
    diagnosis TEXT,
    treatment TEXT,
    vetName TEXT,
    notes TEXT,
    isActive INTEGER NOT NULL DEFAULT 1,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

-- CRUD Operations --
insert:
INSERT INTO Lameness (id, patientId, date, gradeAAEP, limbLocation, flexionTest, diagnosis, treatment, vetName, notes, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Lameness SET
    patientId = ?,
    date = ?,
    gradeAAEP = ?,
    limbLocation = ?,
    flexionTest = ?,
    diagnosis = ?,
    treatment = ?,
    vetName = ?,
    notes = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Lameness WHERE id = ?;

selectById:
SELECT * FROM Lameness WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM Lameness WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM Lameness WHERE isActive = 1;

setInactive:
UPDATE Lameness SET isActive = 0, updatedAt = ? WHERE id = ?;