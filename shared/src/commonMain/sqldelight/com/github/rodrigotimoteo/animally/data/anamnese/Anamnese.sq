-- CRUD Operations --
insert:
INSERT INTO Anamnese (id, patientId, generalHistory, chronicConditions, allergies, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?);

update:
UPDATE Anamnese SET
    generalHistory = ?,
    chronicConditions = ?,
    allergies = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Anamnese WHERE id = ?;

selectById:
SELECT * FROM Anamnese WHERE id = ?;

selectByPatient:
SELECT * FROM Anamnese WHERE patientId = ?;
countActiveByPatient:
SELECT COUNT(*) FROM Anamnese WHERE patientId = ?;

-- Backup support --
deleteAll:
DELETE FROM Anamnese;

selectAllRows:
SELECT * FROM Anamnese;

insertWithId:
INSERT INTO Anamnese (id, patientId, generalHistory, chronicConditions, allergies, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?);

-- Sync support --
selectByServerId:
SELECT * FROM Anamnese WHERE serverId = ?;

selectChangedSince:
SELECT * FROM Anamnese WHERE updatedAt > ?;

setServerId:
UPDATE Anamnese SET serverId = ?, updatedAt = ? WHERE id = ?;
