-- CRUD Operations --
insert:
INSERT INTO Anamnese (id, patientId, generalHistory, chronicConditions, allergies, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?);

update:
UPDATE Anamnese SET
    generalHistory = ?,
    chronicConditions = ?,
    allergies = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Anamnese WHERE id = ?;

selectById:
SELECT * FROM Anamnese WHERE id = ?;

selectByPatient:
SELECT * FROM Anamnese WHERE patientId = ?;
countActiveByPatient:
SELECT COUNT(*) FROM Anamnese WHERE patientId = ?;
