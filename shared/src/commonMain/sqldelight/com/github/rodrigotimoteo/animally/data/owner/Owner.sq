-- SQL Table --
CREATE TABLE Owner (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    email TEXT,
    phone TEXT,
    address TEXT,
    isActive INTEGER NOT NULL DEFAULT 1,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

-- CRUD Operations --
insert:
INSERT INTO Owner (id, name, email, phone, address, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Owner SET
    name = ?,
    email = ?,
    phone = ?,
    address = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Owner WHERE id = ?;

selectById:
SELECT * FROM Owner WHERE id = ? AND isActive = 1;

selectAll:
SELECT * FROM Owner WHERE isActive = 1;

setInactive:
UPDATE Owner SET isActive = 0, updatedAt = ? WHERE id = ?;