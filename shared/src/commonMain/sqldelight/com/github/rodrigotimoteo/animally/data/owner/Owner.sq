-- CRUD Operations --
insert:
INSERT INTO Owner (id, name, email, phone, address, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?);


update:
UPDATE Owner SET
    name = ?,
    email = ?,
    phone = ?,
    address = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Owner WHERE id = ?;

selectById:
SELECT * FROM Owner WHERE id = ? AND isActive = 1;

selectAll:
SELECT * FROM Owner WHERE isActive = 1 ORDER BY id;

setInactive:
UPDATE Owner SET isActive = 0, updatedAt = ? WHERE id = ?;
-- Backup support --
deleteAll:
DELETE FROM Owner;

selectAllRows:
SELECT * FROM Owner;

insertWithId:
INSERT INTO Owner (id, name, email, phone, address, isActive, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

setLocation:
UPDATE Owner SET
    latitude = ?,
    longitude = ?
WHERE id = ?;

-- Sync support --
selectByServerId:
SELECT * FROM Owner WHERE serverId = ?;

selectChangedSince:
SELECT * FROM Owner WHERE updatedAt > ?;

setServerId:
UPDATE Owner SET serverId = ?, updatedAt = ? WHERE id = ?;

-- Sync support: unfiltered row read (pull must see soft-deleted rows)
selectRowById:
SELECT * FROM Owner WHERE id = ?;
