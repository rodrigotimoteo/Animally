-- CRUD Operations --
insert:
INSERT INTO Patient (id, name, species, breed, dateOfBirth, gender, microchipId, ueln, registrationNumber, stableLocation, photoUri, notes, ownerId, isActive, createdAt, updatedAt, cogginsTestDate, cogginsResult, cogginsExpiryDate)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Patient SET
    name = ?,
    species = ?,
    breed = ?,
    dateOfBirth = ?,
    gender = ?,
    microchipId = ?,
    ueln = ?,
    registrationNumber = ?,
    stableLocation = ?,
    photoUri = ?,
    notes = ?,
    ownerId = ?,
    isActive = ?,
    updatedAt = ?,
    cogginsTestDate = ?,
    cogginsResult = ?,
    cogginsExpiryDate = ?
WHERE id = ?;

delete:
DELETE FROM Patient WHERE id = ?;

selectById:
SELECT * FROM Patient WHERE id = ? AND isActive = 1;

selectAll:
SELECT * FROM Patient WHERE isActive = 1;

setInactive:
UPDATE Patient SET isActive = 0, updatedAt = ? WHERE id = ?;

selectActiveByOwnerId:
SELECT * FROM Patient WHERE ownerId = ? AND isActive = 1;

countActiveByOwnerId:
SELECT COUNT(*) FROM Patient WHERE ownerId = ? AND isActive = 1;

-- Backup support --
deleteAll:
DELETE FROM Patient;

selectAllRows:
SELECT * FROM Patient;

insertWithId:
INSERT INTO Patient (id, name, species, breed, dateOfBirth, gender, microchipId, ueln, registrationNumber, stableLocation, photoUri, notes, ownerId, isActive, createdAt, updatedAt, cogginsTestDate, cogginsResult, cogginsExpiryDate)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Sync support --
selectByServerId:
SELECT * FROM Patient WHERE serverId = ? AND isActive = 1;

selectChangedSince:
SELECT * FROM Patient WHERE updatedAt > ?;

setServerId:
UPDATE Patient SET serverId = ?, updatedAt = ? WHERE id = ?;
