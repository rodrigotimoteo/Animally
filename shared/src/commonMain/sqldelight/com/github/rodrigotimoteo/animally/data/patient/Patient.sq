-- SQL Table --
CREATE TABLE Patient (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    species TEXT NOT NULL DEFAULT "Equine",
    breed TEXT,
    dateOfBirth TEXT,
    gender TEXT,
    microchipId TEXT,
    ueln TEXT,
    registrationNumber TEXT,
    stableLocation TEXT,
    photoUri TEXT,
    notes TEXT,
    ownerIds TEXT,
    isActive INTEGER NOT NULL DEFAULT 1,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

-- CRUD Operations --
insert:
INSERT INTO Patient (id, name, species, breed, dateOfBirth, gender, microchipId, ueln, registrationNumber, stableLocation, photoUri, notes, ownerIds, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Patient SET
    name = ?,
    species = ?,
    breed = ?,
    dateOfBirth = ?,
    gender = ?,
    microchipId = ?,
    ueln = ?,
    registrationNumber = ?,
    stableLocation = ?,
    photoUri = ?,
    notes = ?,
    ownerIds = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Patient WHERE id = ?;

selectById:
SELECT * FROM Patient WHERE id = ? AND isActive = 1;

selectAll:
SELECT * FROM Patient WHERE isActive = 1;

setInactive:
UPDATE Patient SET isActive = 0, updatedAt = ? WHERE id = ?;