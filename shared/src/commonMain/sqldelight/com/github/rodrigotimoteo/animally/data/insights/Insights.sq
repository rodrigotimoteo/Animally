-- LocalDate adapter reference via import; view queries rely on import for date handling
selectAdapterWarmup:
SELECT date AS d FROM Consultation UNION ALL SELECT date FROM Dentistry UNION ALL SELECT dateAdministered FROM Deworming UNION ALL SELECT date FROM FarrierVisit UNION ALL SELECT date FROM Imaging UNION ALL SELECT date FROM LabResult UNION ALL SELECT date FROM Lameness UNION ALL SELECT startDate FROM Medication UNION ALL SELECT date FROM Reproduction UNION ALL SELECT dateAdministered FROM ReproMedication UNION ALL SELECT date FROM Surgery UNION ALL SELECT date FROM Substance UNION ALL SELECT date FROM Ultrasound UNION ALL SELECT dateAdministered FROM Vaccination UNION ALL SELECT date FROM Weight UNION ALL SELECT date FROM EmbryoTransfer UNION ALL SELECT date FROM Icsi LIMIT 1;
