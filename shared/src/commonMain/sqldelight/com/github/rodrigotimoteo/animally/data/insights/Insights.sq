-- Canonical reproduction-subtype drill-down. Kotlin performs tolerant subtype
-- parsing (legacy spaces/underscores/hyphens and unknown -> Other), while SQL
-- keeps the range, patient, active-row and active-patient filters exact.
selectReproductionRecordRefsForPatient:
SELECT Reproduction.id AS recordId,
       Reproduction.patientId AS patientId,
       Patient.name AS patientName,
       Reproduction.date AS date,
       Reproduction.eventType AS eventType
FROM Reproduction
JOIN Patient ON Patient.id = Reproduction.patientId
WHERE Reproduction.isActive = 1
AND Patient.isActive = 1
AND Reproduction.date BETWEEN :from AND :to
AND Reproduction.patientId = :patientId
ORDER BY Reproduction.date DESC, Reproduction.id DESC;

selectReproductionRecordRefsGlobal:
SELECT Reproduction.id AS recordId,
       Reproduction.patientId AS patientId,
       Patient.name AS patientName,
       Reproduction.date AS date,
       Reproduction.eventType AS eventType
FROM Reproduction
JOIN Patient ON Patient.id = Reproduction.patientId
WHERE Reproduction.isActive = 1
AND Patient.isActive = 1
AND Reproduction.date BETWEEN :from AND :to
ORDER BY Reproduction.date DESC, Reproduction.id DESC;

-- Earliest: scoped
selectEarliestActivityDateForPatient:
WITH activity_rows AS (
  SELECT date AS activityDate, patientId FROM Consultation WHERE isActive = 1 AND patientId = :patientId
  UNION ALL
  SELECT date, patientId FROM Dentistry WHERE isActive = 1 AND patientId = :patientId
  UNION ALL
  SELECT dateAdministered, patientId FROM Deworming WHERE isActive = 1 AND patientId = :patientId
  UNION ALL
  SELECT date, patientId FROM FarrierVisit WHERE isActive = 1 AND patientId = :patientId
  UNION ALL
  SELECT date, patientId FROM Imaging WHERE isActive = 1 AND patientId = :patientId
  UNION ALL
  SELECT date, patientId FROM LabResult WHERE isActive = 1 AND patientId = :patientId
  UNION ALL
  SELECT date, patientId FROM Lameness WHERE isActive = 1 AND patientId = :patientId
  UNION ALL
  SELECT startDate, patientId FROM Medication WHERE isActive = 1 AND startDate IS NOT NULL AND patientId = :patientId
  UNION ALL
  SELECT date, patientId FROM Reproduction WHERE isActive = 1 AND patientId = :patientId
  UNION ALL
  SELECT dateAdministered, patientId FROM ReproMedication WHERE isActive = 1 AND patientId = :patientId
  UNION ALL
  SELECT date, patientId FROM Surgery WHERE isActive = 1 AND patientId = :patientId
  UNION ALL
  SELECT date, patientId FROM Substance WHERE isActive = 1 AND patientId = :patientId
  UNION ALL
  SELECT date, patientId FROM Ultrasound WHERE isActive = 1 AND patientId = :patientId
  UNION ALL
  SELECT dateAdministered, patientId FROM Vaccination WHERE isActive = 1 AND patientId = :patientId
  UNION ALL
  SELECT date, patientId FROM Weight WHERE isActive = 1 AND patientId = :patientId
  UNION ALL
  SELECT date, patientId FROM EmbryoTransfer WHERE isActive = 1 AND patientId = :patientId
  UNION ALL
  SELECT date, patientId FROM Icsi WHERE isActive = 1 AND patientId = :patientId
)
SELECT activityDate
FROM activity_rows
JOIN Patient ON Patient.id = activity_rows.patientId
WHERE Patient.isActive = 1
ORDER BY activityDate ASC
LIMIT 1;

-- Earliest: global (no patient filter)
selectEarliestActivityDateGlobal:
WITH activity_rows AS (
