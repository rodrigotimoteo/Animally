  UNION ALL
  SELECT id, patientId, date, 'ULTRASOUND' FROM Ultrasound WHERE isActive = 1 AND date >= :from AND date <= :to AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT id, patientId, dateAdministered, 'VACCINATION' FROM Vaccination WHERE isActive = 1 AND dateAdministered >= :from AND dateAdministered <= :to AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT id, patientId, date, 'EMBRYO_TRANSFER' FROM EmbryoTransfer WHERE isActive = 1 AND date >= :from AND date <= :to AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT id, patientId, date, 'ICSI' FROM Icsi WHERE isActive = 1 AND date >= :from AND date <= :to AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
)
SELECT recordId, missing_rows.patientId AS patientId, Patient.name AS patientName, activityDate AS date, recordType AS recordTypeWireName
FROM missing_rows
JOIN Patient ON Patient.id = missing_rows.patientId
WHERE Patient.isActive = 1
ORDER BY activityDate DESC, recordId DESC;

-- Unlinked owner: activity rows whose patient has ownerId IS NULL (missing for analysis)
selectUnlinkedOwnerCountForPatient:
