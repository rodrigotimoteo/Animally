AND (Ultrasound.uterineEdema IS NULL OR LENGTH(TRIM(Ultrasound.uterineEdema)) = 0)
AND Ultrasound.uterineLiquid IS NULL
AND (Ultrasound.uterineLiquidDescription IS NULL OR LENGTH(TRIM(Ultrasound.uterineLiquidDescription)) = 0)
AND (Ultrasound.uterusDescription IS NULL OR LENGTH(TRIM(Ultrasound.uterusDescription)) = 0);

