import kotlinx.datetime.LocalDate;

-- Insights.sq — Activity aggregation + reproduction aggregates + earliest-date helpers.
-- C1 simplified: 17-table UNION ALL extracted to views insights_activity_rows + insights_activity_active.
-- Base view holds raw active rows; filtered view joins Patient.isActive=1 for reuse.
-- Scoped vs global split retained for sargable predicates (SEARCH via idx_*_patient_date vs SCAN INDEX).
-- Migration 15 notes nullable (:pid IS NULL OR patientId=:pid) -> SCAN, so split kept; shared fragment deduplicated via views below.
-- Partial indexes WHERE isActive=1 match view branches; Medication filters startDate IS NOT NULL.
-- Reproduction tolerant parser lower(replace(...)) single-sourced with ReproductionEventType.normalize;
-- SQL NOT IN list ('heat','breeding','pregnancycheck','foaling','initialexam') derived from ReproductionEventType.knownNormalizedValues.

CREATE VIEW IF NOT EXISTS insights_activity_rows AS
  SELECT id AS recordId, patientId, date AS activityDate, 'CONSULTATION' AS recordType, vetName AS vetAttr FROM Consultation WHERE isActive = 1
  UNION ALL SELECT id, patientId, date, 'DENTISTRY', vetName FROM Dentistry WHERE isActive = 1
  UNION ALL SELECT id, patientId, dateAdministered, 'DEWORMING', vetName FROM Deworming WHERE isActive = 1
  UNION ALL SELECT id, patientId, date, 'FARRIER_VISIT', farrier FROM FarrierVisit WHERE isActive = 1
  UNION ALL SELECT id, patientId, date, 'IMAGING', vetName FROM Imaging WHERE isActive = 1
  UNION ALL SELECT id, patientId, date, 'LAB_RESULT', vetName FROM LabResult WHERE isActive = 1
  UNION ALL SELECT id, patientId, date, 'LAMENESS', vetName FROM Lameness WHERE isActive = 1
  UNION ALL SELECT id, patientId, startDate, 'MEDICATION', prescribedBy FROM Medication WHERE isActive = 1 AND startDate IS NOT NULL
  UNION ALL SELECT id, patientId, date, 'REPRODUCTION_EVENT', vetName FROM Reproduction WHERE isActive = 1
  UNION ALL SELECT id, patientId, dateAdministered, 'REPRO_MEDICATION', vetName FROM ReproMedication WHERE isActive = 1
  UNION ALL SELECT id, patientId, date, 'SURGERY', surgeon FROM Surgery WHERE isActive = 1
  UNION ALL SELECT id, patientId, date, 'CONTROLLED_SUBSTANCE', administeredBy FROM Substance WHERE isActive = 1
  UNION ALL SELECT id, patientId, date, 'ULTRASOUND', vetName FROM Ultrasound WHERE isActive = 1
  UNION ALL SELECT id, patientId, dateAdministered, 'VACCINATION', vetName FROM Vaccination WHERE isActive = 1
  UNION ALL SELECT id, patientId, date, 'WEIGHT', 'ok' FROM Weight WHERE isActive = 1
  UNION ALL SELECT id, patientId, date, 'EMBRYO_TRANSFER', vetName FROM EmbryoTransfer WHERE isActive = 1
  UNION ALL SELECT id, patientId, date, 'ICSI', vetName FROM Icsi WHERE isActive = 1;

CREATE VIEW IF NOT EXISTS insights_activity_active AS
  SELECT r.recordId, r.patientId, r.activityDate, r.recordType, r.vetAttr, p.name AS patientName, p.ownerId
  FROM insights_activity_rows r JOIN Patient p ON p.id = r.patientId WHERE p.isActive = 1;

CREATE VIEW IF NOT EXISTS insights_missing_vet AS
  SELECT * FROM insights_activity_active WHERE vetAttr IS NULL OR LENGTH(TRIM(vetAttr)) = 0;

CREATE VIEW IF NOT EXISTS insights_unlinked_owner AS
  SELECT * FROM insights_activity_active WHERE ownerId IS NULL;

CREATE VIEW IF NOT EXISTS insights_free_text_embryo AS
  SELECT EmbryoTransfer.id AS recordId, EmbryoTransfer.patientId AS patientId, Patient.name AS patientName, EmbryoTransfer.date AS date, 'EMBRYO_TRANSFER' AS recordTypeWireName
  FROM EmbryoTransfer JOIN Patient ON Patient.id = EmbryoTransfer.patientId
  WHERE EmbryoTransfer.isActive = 1 AND Patient.isActive = 1 AND EmbryoTransfer.recipientMares IS NOT NULL AND LENGTH(TRIM(EmbryoTransfer.recipientMares)) > 0;

CREATE VIEW IF NOT EXISTS insights_incomplete_ultrasound AS
  SELECT Ultrasound.id AS recordId, Ultrasound.patientId AS patientId, Patient.name AS patientName, Ultrasound.date AS date, 'ULTRASOUND' AS recordTypeWireName
  FROM Ultrasound JOIN Patient ON Patient.id = Ultrasound.patientId
  WHERE Ultrasound.isActive = 1 AND Patient.isActive = 1
  AND (Ultrasound.ovaryStatus IS NULL OR LENGTH(TRIM(Ultrasound.ovaryStatus)) = 0)
  AND (Ultrasound.uterineStatus IS NULL OR LENGTH(TRIM(Ultrasound.uterineStatus)) = 0)
  AND Ultrasound.follicleSizeMm IS NULL
  AND (Ultrasound.leftOvaryStatus IS NULL OR LENGTH(TRIM(Ultrasound.leftOvaryStatus)) = 0)
  AND (Ultrasound.rightOvaryStatus IS NULL OR LENGTH(TRIM(Ultrasound.rightOvaryStatus)) = 0)
  AND Ultrasound.leftFollicleSizeMm IS NULL
  AND Ultrasound.rightFollicleSizeMm IS NULL
  AND (Ultrasound.uterineEdema IS NULL OR LENGTH(TRIM(Ultrasound.uterineEdema)) = 0)
  AND Ultrasound.uterineLiquid IS NULL
  AND (Ultrasound.uterineLiquidDescription IS NULL OR LENGTH(TRIM(Ultrasound.uterineLiquidDescription)) = 0)
  AND (Ultrasound.uterusDescription IS NULL OR LENGTH(TRIM(Ultrasound.uterusDescription)) = 0);

-- Buckets: scoped vs global — sargable via WHERE pushdown into view branches
selectActivityBucketsForPatient:
SELECT activityDate AS date, patientId, recordType AS recordTypeWireName, COUNT(*) AS cnt
FROM insights_activity_active
WHERE activityDate >= :from AND activityDate <= :to AND patientId = :patientId
GROUP BY activityDate, patientId, recordType;

selectActivityBucketsGlobal:
SELECT activityDate AS date, patientId, recordType AS recordTypeWireName, COUNT(*) AS cnt
FROM insights_activity_active
WHERE activityDate >= :from AND activityDate <= :to
GROUP BY activityDate, patientId, recordType;

-- Record refs: scoped/global with nullable wire collapsed via (:wire IS NULL OR recordType=:wire) — wire not indexed so no sargability loss, patient split retained.
selectActivityRecordRefsForPatient:
SELECT recordId, patientId, patientName, activityDate AS date, recordType AS recordTypeWireName
FROM insights_activity_active
WHERE activityDate >= :from AND activityDate <= :to AND patientId = :patientId AND (:recordTypeWireName IS NULL OR recordType = :recordTypeWireName)
ORDER BY activityDate DESC, recordId DESC;

selectActivityRecordRefsGlobal:
SELECT recordId, patientId, patientName, activityDate AS date, recordType AS recordTypeWireName
FROM insights_activity_active
WHERE activityDate >= :from AND activityDate <= :to AND (:recordTypeWireName IS NULL OR recordType = :recordTypeWireName)
ORDER BY activityDate DESC, recordId DESC;

-- Canonical reproduction-subtype drill-down. Tolerant normalization in SQL via lower/replace,
-- sargable range/patient predicates retained for idx_reproduction_patient_date.
-- Shared fragment: Reproduction.isActive=1 AND Patient.isActive=1 AND date BETWEEN :from AND :to [+ patientId=:pid] [+ normalized filter]
-- SQL lower(replace...) single-sourced with ReproductionEventType.normalize; NOT IN list derived from knownNormalizedValues.
selectReproductionRecordRefsForPatientByNormalized:
SELECT Reproduction.id AS recordId,
       Reproduction.patientId AS patientId,
       Patient.name AS patientName,
       Reproduction.date AS date,
       Reproduction.eventType AS eventType
FROM Reproduction
JOIN Patient ON Patient.id = Reproduction.patientId
WHERE Reproduction.isActive = 1
AND Patient.isActive = 1
AND Reproduction.date >= :from AND Reproduction.date <= :to
AND Reproduction.patientId = :patientId
AND lower(replace(replace(replace(Reproduction.eventType, ' ', ''), '_', ''), '-', '')) = :normalized
ORDER BY Reproduction.date DESC, Reproduction.id DESC;

selectReproductionRecordRefsGlobalByNormalized:
SELECT Reproduction.id AS recordId,
       Reproduction.patientId AS patientId,
       Patient.name AS patientName,
       Reproduction.date AS date,
       Reproduction.eventType AS eventType
FROM Reproduction
JOIN Patient ON Patient.id = Reproduction.patientId
WHERE Reproduction.isActive = 1
AND Patient.isActive = 1
AND Reproduction.date >= :from AND Reproduction.date <= :to
AND lower(replace(replace(replace(Reproduction.eventType, ' ', ''), '_', ''), '-', '')) = :normalized
ORDER BY Reproduction.date DESC, Reproduction.id DESC;

-- Earliest: scoped / global
selectEarliestActivityDateForPatient:
SELECT activityDate FROM insights_activity_active WHERE patientId = :patientId ORDER BY activityDate ASC LIMIT 1;

selectEarliestActivityDateGlobal:
SELECT activityDate FROM insights_activity_active ORDER BY activityDate ASC LIMIT 1;

-- Reproduction period facts (Task 10): sargable scoped/global split, inclusive range, Patient.isActive=1, isActive=1
-- Shared fragment deduplicated: FROM Reproduction JOIN Patient WHERE isActive=1 AND date BETWEEN :from AND :to [+ patientId=:pid]
selectReproductionEventCountsForPatient:
SELECT eventType, COUNT(*) AS cnt FROM Reproduction
JOIN Patient ON Patient.id = Reproduction.patientId
WHERE Reproduction.isActive = 1 AND Patient.isActive = 1
AND Reproduction.date BETWEEN :from AND :to AND Reproduction.patientId = :patientId
GROUP BY eventType;

selectReproductionEventCountsGlobal:
SELECT eventType, COUNT(*) AS cnt FROM Reproduction
JOIN Patient ON Patient.id = Reproduction.patientId
WHERE Reproduction.isActive = 1 AND Patient.isActive = 1
AND Reproduction.date BETWEEN :from AND :to
GROUP BY eventType;

selectEmbryoStatsForPatient:
SELECT COUNT(*) AS collections, COALESCE(SUM(embryoCount), 0) AS totalEmbryos FROM EmbryoTransfer
JOIN Patient ON Patient.id = EmbryoTransfer.patientId
WHERE EmbryoTransfer.isActive = 1 AND Patient.isActive = 1
AND EmbryoTransfer.date BETWEEN :from AND :to AND EmbryoTransfer.patientId = :patientId;

selectEmbryoStatsGlobal:
SELECT COUNT(*) AS collections, COALESCE(SUM(embryoCount), 0) AS totalEmbryos FROM EmbryoTransfer
JOIN Patient ON Patient.id = EmbryoTransfer.patientId
WHERE EmbryoTransfer.isActive = 1 AND Patient.isActive = 1
AND EmbryoTransfer.date BETWEEN :from AND :to;

selectIcsiStatsForPatient:
SELECT COUNT(*) AS sessions, COALESCE(SUM(folliclesRecovered), 0) AS totalFollicles FROM Icsi
JOIN Patient ON Patient.id = Icsi.patientId
WHERE Icsi.isActive = 1 AND Patient.isActive = 1
AND Icsi.date BETWEEN :from AND :to AND Icsi.patientId = :patientId;

selectIcsiStatsGlobal:
SELECT COUNT(*) AS sessions, COALESCE(SUM(folliclesRecovered), 0) AS totalFollicles FROM Icsi
JOIN Patient ON Patient.id = Icsi.patientId
WHERE Icsi.isActive = 1 AND Patient.isActive = 1
AND Icsi.date BETWEEN :from AND :to;

selectUltrasoundCountForPatient:
SELECT COUNT(*) AS cnt FROM Ultrasound
JOIN Patient ON Patient.id = Ultrasound.patientId
WHERE Ultrasound.isActive = 1 AND Patient.isActive = 1
AND Ultrasound.date BETWEEN :from AND :to AND Ultrasound.patientId = :patientId;

selectUltrasoundCountGlobal:
SELECT COUNT(*) AS cnt FROM Ultrasound
JOIN Patient ON Patient.id = Ultrasound.patientId
WHERE Ultrasound.isActive = 1 AND Patient.isActive = 1
AND Ultrasound.date BETWEEN :from AND :to;

-- Task 13: Research-readiness counts + drill-down. Sargable scoped/global split, shared fragment.
-- Unknown reproduction category: tolerant NOT IN known normalized list, single-sourced via ReproductionEventType.knownNormalizedValues.
selectUnknownReproductionCountForPatient:
SELECT COUNT(*) AS cnt FROM Reproduction
JOIN Patient ON Patient.id = Reproduction.patientId
WHERE Reproduction.isActive = 1 AND Patient.isActive = 1
AND Reproduction.date >= :from AND Reproduction.date <= :to AND Reproduction.patientId = :patientId
AND lower(replace(replace(replace(Reproduction.eventType, ' ', ''), '_', ''), '-', '')) NOT IN ('heat','breeding','pregnancycheck','foaling','initialexam');

selectUnknownReproductionCountGlobal:
SELECT COUNT(*) AS cnt FROM Reproduction
JOIN Patient ON Patient.id = Reproduction.patientId
WHERE Reproduction.isActive = 1 AND Patient.isActive = 1
AND Reproduction.date >= :from AND Reproduction.date <= :to
AND lower(replace(replace(replace(Reproduction.eventType, ' ', ''), '_', ''), '-', '')) NOT IN ('heat','breeding','pregnancycheck','foaling','initialexam');

selectUnknownReproductionRefsForPatient:
SELECT Reproduction.id AS recordId, Reproduction.patientId AS patientId, Patient.name AS patientName, Reproduction.date AS date, Reproduction.eventType AS eventType
FROM Reproduction
JOIN Patient ON Patient.id = Reproduction.patientId
WHERE Reproduction.isActive = 1 AND Patient.isActive = 1
AND Reproduction.date >= :from AND Reproduction.date <= :to AND Reproduction.patientId = :patientId
AND lower(replace(replace(replace(Reproduction.eventType, ' ', ''), '_', ''), '-', '')) NOT IN ('heat','breeding','pregnancycheck','foaling','initialexam')
ORDER BY Reproduction.date DESC, Reproduction.id DESC;

selectUnknownReproductionRefsGlobal:
SELECT Reproduction.id AS recordId, Reproduction.patientId AS patientId, Patient.name AS patientName, Reproduction.date AS date, Reproduction.eventType AS eventType
FROM Reproduction
JOIN Patient ON Patient.id = Reproduction.patientId
WHERE Reproduction.isActive = 1 AND Patient.isActive = 1
AND Reproduction.date >= :from AND Reproduction.date <= :to
AND lower(replace(replace(replace(Reproduction.eventType, ' ', ''), '_', ''), '-', '')) NOT IN ('heat','breeding','pregnancycheck','foaling','initialexam')
ORDER BY Reproduction.date DESC, Reproduction.id DESC;

-- Free-text embryo recipient via view
selectFreeTextEmbryoCountForPatient:
SELECT COUNT(*) AS cnt FROM insights_free_text_embryo WHERE date >= :from AND date <= :to AND patientId = :patientId;

selectFreeTextEmbryoCountGlobal:
SELECT COUNT(*) AS cnt FROM insights_free_text_embryo WHERE date >= :from AND date <= :to;

selectFreeTextEmbryoRefsForPatient:
SELECT recordId, patientId, patientName, date, recordTypeWireName FROM insights_free_text_embryo WHERE date >= :from AND date <= :to AND patientId = :patientId ORDER BY date DESC, recordId DESC;

selectFreeTextEmbryoRefsGlobal:
SELECT recordId, patientId, patientName, date, recordTypeWireName FROM insights_free_text_embryo WHERE date >= :from AND date <= :to ORDER BY date DESC, recordId DESC;

