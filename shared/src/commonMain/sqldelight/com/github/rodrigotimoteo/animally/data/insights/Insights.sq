  SELECT id, patientId, date, 'ULTRASOUND' FROM Ultrasound WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId
  UNION ALL
  SELECT id, patientId, dateAdministered, 'VACCINATION' FROM Vaccination WHERE isActive = 1 AND dateAdministered >= :from AND dateAdministered <= :to AND patientId = :patientId
  UNION ALL
  SELECT id, patientId, date, 'WEIGHT' FROM Weight WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId
