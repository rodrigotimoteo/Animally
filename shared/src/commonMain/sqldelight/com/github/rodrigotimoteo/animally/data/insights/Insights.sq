)
SELECT activityDate
FROM activity_rows
JOIN Patient ON Patient.id = activity_rows.patientId
WHERE Patient.isActive = 1
ORDER BY activityDate ASC
LIMIT 1;

-- Reproduction period facts (Task 10): sargable scoped/global split, inclusive range, Patient.isActive=1, isActive=1
selectReproductionEventCountsForPatient:
SELECT eventType, COUNT(*) AS cnt FROM Reproduction
JOIN Patient ON Patient.id = Reproduction.patientId
WHERE Reproduction.isActive = 1 AND Patient.isActive = 1
AND Reproduction.date BETWEEN :from AND :to AND Reproduction.patientId = :patientId
GROUP BY eventType;

selectReproductionEventCountsGlobal:
SELECT eventType, COUNT(*) AS cnt FROM Reproduction
JOIN Patient ON Patient.id = Reproduction.patientId
WHERE Reproduction.isActive = 1 AND Patient.isActive = 1
AND Reproduction.date BETWEEN :from AND :to
GROUP BY eventType;

selectEmbryoStatsForPatient:
SELECT COUNT(*) AS collections, COALESCE(SUM(embryoCount), 0) AS totalEmbryos FROM EmbryoTransfer
JOIN Patient ON Patient.id = EmbryoTransfer.patientId
WHERE EmbryoTransfer.isActive = 1 AND Patient.isActive = 1
AND EmbryoTransfer.date BETWEEN :from AND :to AND EmbryoTransfer.patientId = :patientId;

selectEmbryoStatsGlobal:
SELECT COUNT(*) AS collections, COALESCE(SUM(embryoCount), 0) AS totalEmbryos FROM EmbryoTransfer
JOIN Patient ON Patient.id = EmbryoTransfer.patientId
WHERE EmbryoTransfer.isActive = 1 AND Patient.isActive = 1
AND EmbryoTransfer.date BETWEEN :from AND :to;

selectIcsiStatsForPatient:
SELECT COUNT(*) AS sessions, COALESCE(SUM(folliclesRecovered), 0) AS totalFollicles FROM Icsi
JOIN Patient ON Patient.id = Icsi.patientId
WHERE Icsi.isActive = 1 AND Patient.isActive = 1
AND Icsi.date BETWEEN :from AND :to AND Icsi.patientId = :patientId;

selectIcsiStatsGlobal:
SELECT COUNT(*) AS sessions, COALESCE(SUM(folliclesRecovered), 0) AS totalFollicles FROM Icsi
JOIN Patient ON Patient.id = Icsi.patientId
WHERE Icsi.isActive = 1 AND Patient.isActive = 1
AND Icsi.date BETWEEN :from AND :to;

selectUltrasoundCountForPatient:
SELECT COUNT(*) AS cnt FROM Ultrasound
JOIN Patient ON Patient.id = Ultrasound.patientId
WHERE Ultrasound.isActive = 1 AND Patient.isActive = 1
AND Ultrasound.date BETWEEN :from AND :to AND Ultrasound.patientId = :patientId;

selectUltrasoundCountGlobal:
SELECT COUNT(*) AS cnt FROM Ultrasound
JOIN Patient ON Patient.id = Ultrasound.patientId
WHERE Ultrasound.isActive = 1 AND Patient.isActive = 1
AND Ultrasound.date BETWEEN :from AND :to;

-- Task 13: Research-readiness counts + drill-down. Sargable scoped/global split,
-- inclusive range, isActive=1, Patient.isActive=1, partial index friendly.
-- Each rule has explicit definition surfaced as "missing for analysis", not clinically wrong.

-- Unknown reproduction category: raw eventType list for Kotlin Other detection (tolerant parse)
selectReproductionEventTypesForPatient:
SELECT eventType FROM Reproduction
JOIN Patient ON Patient.id = Reproduction.patientId
WHERE Reproduction.isActive = 1 AND Patient.isActive = 1
AND Reproduction.date >= :from AND Reproduction.date <= :to AND Reproduction.patientId = :patientId;

selectReproductionEventTypesGlobal:
SELECT eventType FROM Reproduction
JOIN Patient ON Patient.id = Reproduction.patientId
WHERE Reproduction.isActive = 1 AND Patient.isActive = 1
AND Reproduction.date >= :from AND Reproduction.date <= :to;

selectUnknownReproductionRefsForPatient:
SELECT Reproduction.id AS recordId, Reproduction.patientId AS patientId, Patient.name AS patientName, Reproduction.date AS date, Reproduction.eventType AS eventType
FROM Reproduction
JOIN Patient ON Patient.id = Reproduction.patientId
WHERE Reproduction.isActive = 1 AND Patient.isActive = 1
AND Reproduction.date >= :from AND Reproduction.date <= :to AND Reproduction.patientId = :patientId
ORDER BY Reproduction.date DESC, Reproduction.id DESC;

selectUnknownReproductionRefsGlobal:
SELECT Reproduction.id AS recordId, Reproduction.patientId AS patientId, Patient.name AS patientName, Reproduction.date AS date, Reproduction.eventType AS eventType
FROM Reproduction
JOIN Patient ON Patient.id = Reproduction.patientId
WHERE Reproduction.isActive = 1 AND Patient.isActive = 1
AND Reproduction.date >= :from AND Reproduction.date <= :to
ORDER BY Reproduction.date DESC, Reproduction.id DESC;

-- Free-text embryo recipient (recipientMares non-empty)
selectFreeTextEmbryoCountForPatient:
SELECT COUNT(*) AS cnt FROM EmbryoTransfer
JOIN Patient ON Patient.id = EmbryoTransfer.patientId
WHERE EmbryoTransfer.isActive = 1 AND Patient.isActive = 1
AND EmbryoTransfer.date >= :from AND EmbryoTransfer.date <= :to AND EmbryoTransfer.patientId = :patientId
AND EmbryoTransfer.recipientMares IS NOT NULL AND LENGTH(TRIM(EmbryoTransfer.recipientMares)) > 0;

selectFreeTextEmbryoCountGlobal:
SELECT COUNT(*) AS cnt FROM EmbryoTransfer
JOIN Patient ON Patient.id = EmbryoTransfer.patientId
WHERE EmbryoTransfer.isActive = 1 AND Patient.isActive = 1
AND EmbryoTransfer.date >= :from AND EmbryoTransfer.date <= :to
AND EmbryoTransfer.recipientMares IS NOT NULL AND LENGTH(TRIM(EmbryoTransfer.recipientMares)) > 0;

selectFreeTextEmbryoRefsForPatient:
SELECT EmbryoTransfer.id AS recordId, EmbryoTransfer.patientId AS patientId, Patient.name AS patientName, EmbryoTransfer.date AS date, 'EMBRYO_TRANSFER' AS recordTypeWireName
FROM EmbryoTransfer
JOIN Patient ON Patient.id = EmbryoTransfer.patientId
WHERE EmbryoTransfer.isActive = 1 AND Patient.isActive = 1
AND EmbryoTransfer.date >= :from AND EmbryoTransfer.date <= :to AND EmbryoTransfer.patientId = :patientId
AND EmbryoTransfer.recipientMares IS NOT NULL AND LENGTH(TRIM(EmbryoTransfer.recipientMares)) > 0
ORDER BY EmbryoTransfer.date DESC, EmbryoTransfer.id DESC;

selectFreeTextEmbryoRefsGlobal:
SELECT EmbryoTransfer.id AS recordId, EmbryoTransfer.patientId AS patientId, Patient.name AS patientName, EmbryoTransfer.date AS date, 'EMBRYO_TRANSFER' AS recordTypeWireName
