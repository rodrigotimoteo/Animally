  UNION ALL
  SELECT id, patientId, dateAdministered, 'REPRO_MEDICATION' FROM ReproMedication WHERE isActive = 1 AND dateAdministered >= :from AND dateAdministered <= :to AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
