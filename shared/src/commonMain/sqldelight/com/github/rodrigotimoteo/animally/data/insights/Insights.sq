-- Missing veterinarian name: UNION across 16 dated tables (Weight excluded, no vet field).
-- Branch predicates are sargable on (patientId, date) via existing partial indexes.
selectMissingVetCountForPatient:
SELECT COUNT(*) AS cnt FROM (
  SELECT patientId FROM Consultation WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT patientId FROM Dentistry WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT patientId FROM Deworming WHERE isActive = 1 AND dateAdministered >= :from AND dateAdministered <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT patientId FROM FarrierVisit WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (farrier IS NULL OR LENGTH(TRIM(farrier)) = 0)
  UNION ALL
  SELECT patientId FROM Imaging WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT patientId FROM LabResult WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT patientId FROM Lameness WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT patientId FROM Medication WHERE isActive = 1 AND startDate IS NOT NULL AND startDate >= :from AND startDate <= :to AND patientId = :patientId AND (prescribedBy IS NULL OR LENGTH(TRIM(prescribedBy)) = 0)
  UNION ALL
  SELECT patientId FROM Reproduction WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT patientId FROM ReproMedication WHERE isActive = 1 AND dateAdministered >= :from AND dateAdministered <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT patientId FROM Surgery WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (surgeon IS NULL OR LENGTH(TRIM(surgeon)) = 0)
  UNION ALL
  SELECT patientId FROM Substance WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (administeredBy IS NULL OR LENGTH(TRIM(administeredBy)) = 0)
  UNION ALL
  SELECT patientId FROM Ultrasound WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT patientId FROM Vaccination WHERE isActive = 1 AND dateAdministered >= :from AND dateAdministered <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT patientId FROM EmbryoTransfer WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT patientId FROM Icsi WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
) AS missing
JOIN Patient ON Patient.id = missing.patientId
WHERE Patient.isActive = 1;

