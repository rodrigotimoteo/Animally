  SELECT patientId FROM Consultation WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId
  UNION ALL
  SELECT patientId FROM Dentistry WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId
  UNION ALL
