  SELECT id, patientId, date, 'EMBRYO_TRANSFER' FROM EmbryoTransfer WHERE isActive = 1 AND date BETWEEN :from AND :to AND patientId = :patientId
  UNION ALL
  SELECT id, patientId, date, 'ICSI' FROM Icsi WHERE isActive = 1 AND date BETWEEN :from AND :to AND patientId = :patientId
