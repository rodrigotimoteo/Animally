JOIN Patient ON Patient.id = missing.patientId
WHERE Patient.isActive = 1;

selectMissingVetRefsForPatient:
WITH missing_rows AS (
  SELECT id AS recordId, patientId, date AS activityDate, 'CONSULTATION' AS recordType FROM Consultation WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT id, patientId, date, 'DENTISTRY' FROM Dentistry WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT id, patientId, dateAdministered, 'DEWORMING' FROM Deworming WHERE isActive = 1 AND dateAdministered >= :from AND dateAdministered <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT id, patientId, date, 'FARRIER_VISIT' FROM FarrierVisit WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (farrier IS NULL OR LENGTH(TRIM(farrier)) = 0)
  UNION ALL
  SELECT id, patientId, date, 'IMAGING' FROM Imaging WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT id, patientId, date, 'LAB_RESULT' FROM LabResult WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT id, patientId, date, 'LAMENESS' FROM Lameness WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT id, patientId, startDate, 'MEDICATION' FROM Medication WHERE isActive = 1 AND startDate IS NOT NULL AND startDate >= :from AND startDate <= :to AND patientId = :patientId AND (prescribedBy IS NULL OR LENGTH(TRIM(prescribedBy)) = 0)
  UNION ALL
  SELECT id, patientId, date, 'REPRODUCTION_EVENT' FROM Reproduction WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT id, patientId, dateAdministered, 'REPRO_MEDICATION' FROM ReproMedication WHERE isActive = 1 AND dateAdministered >= :from AND dateAdministered <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT id, patientId, date, 'SURGERY' FROM Surgery WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (surgeon IS NULL OR LENGTH(TRIM(surgeon)) = 0)
  UNION ALL
  SELECT id, patientId, date, 'CONTROLLED_SUBSTANCE' FROM Substance WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (administeredBy IS NULL OR LENGTH(TRIM(administeredBy)) = 0)
  UNION ALL
  SELECT id, patientId, date, 'ULTRASOUND' FROM Ultrasound WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT id, patientId, dateAdministered, 'VACCINATION' FROM Vaccination WHERE isActive = 1 AND dateAdministered >= :from AND dateAdministered <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT id, patientId, date, 'EMBRYO_TRANSFER' FROM EmbryoTransfer WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
  UNION ALL
  SELECT id, patientId, date, 'ICSI' FROM Icsi WHERE isActive = 1 AND date >= :from AND date <= :to AND patientId = :patientId AND (vetName IS NULL OR LENGTH(TRIM(vetName)) = 0)
)
SELECT recordId, missing_rows.patientId AS patientId, Patient.name AS patientName, activityDate AS date, recordType AS recordTypeWireName
FROM missing_rows
JOIN Patient ON Patient.id = missing_rows.patientId
WHERE Patient.isActive = 1
ORDER BY activityDate DESC, recordId DESC;

