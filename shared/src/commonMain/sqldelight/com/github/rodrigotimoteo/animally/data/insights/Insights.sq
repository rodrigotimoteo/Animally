import kotlinx.datetime.LocalDate;

-- Insights.sq — Activity aggregation + reproduction aggregates + earliest-date helpers.
-- Insights activity aggregation. M6 perf fix: split patient-scoped vs global to make predicates sargable.
-- Previously each branch used (:patientId IS NULL OR patientId = :patientId) → prevented index use (SCAN).
-- Now repository dispatches: when patientId != null uses patient equality (SEARCH via idx_*_patient_date),
-- when null uses global variant without patient predicate (SCAN INDEX covering, not SCAN TABLE).
-- Partial indexes WHERE isActive=1 match branch WHERE isActive=1.
-- Medication additionally filters startDate IS NOT NULL, matching partial index.

-- Buckets: scoped (patient equality)
selectActivityBucketsForPatient:
WITH activity_rows AS (
  SELECT date AS activityDate, patientId, 'CONSULTATION' AS recordType FROM Consultation WHERE isActive = 1 AND date BETWEEN :from AND :to AND patientId = :patientId
  UNION ALL
  SELECT date, patientId, 'DENTISTRY' FROM Dentistry WHERE isActive = 1 AND date BETWEEN :from AND :to AND patientId = :patientId
  UNION ALL
  SELECT dateAdministered, patientId, 'DEWORMING' FROM Deworming WHERE isActive = 1 AND dateAdministered BETWEEN :from AND :to AND patientId = :patientId
  UNION ALL
  SELECT date, patientId, 'FARRIER_VISIT' FROM FarrierVisit WHERE isActive = 1 AND date BETWEEN :from AND :to AND patientId = :patientId
  UNION ALL
  SELECT date, patientId, 'IMAGING' FROM Imaging WHERE isActive = 1 AND date BETWEEN :from AND :to AND patientId = :patientId
  UNION ALL
  SELECT date, patientId, 'LAB_RESULT' FROM LabResult WHERE isActive = 1 AND date BETWEEN :from AND :to AND patientId = :patientId
  UNION ALL
  SELECT date, patientId, 'LAMENESS' FROM Lameness WHERE isActive = 1 AND date BETWEEN :from AND :to AND patientId = :patientId
  UNION ALL
  SELECT startDate, patientId, 'MEDICATION' FROM Medication WHERE isActive = 1 AND startDate IS NOT NULL AND startDate BETWEEN :from AND :to AND patientId = :patientId
  UNION ALL
  SELECT date, patientId, 'REPRODUCTION_EVENT' FROM Reproduction WHERE isActive = 1 AND date BETWEEN :from AND :to AND patientId = :patientId
  UNION ALL
  SELECT dateAdministered, patientId, 'REPRO_MEDICATION' FROM ReproMedication WHERE isActive = 1 AND dateAdministered BETWEEN :from AND :to AND patientId = :patientId
  UNION ALL
  SELECT date, patientId, 'SURGERY' FROM Surgery WHERE isActive = 1 AND date BETWEEN :from AND :to AND patientId = :patientId
  UNION ALL
  SELECT date, patientId, 'CONTROLLED_SUBSTANCE' FROM Substance WHERE isActive = 1 AND date BETWEEN :from AND :to AND patientId = :patientId
  UNION ALL
  SELECT date, patientId, 'ULTRASOUND' FROM Ultrasound WHERE isActive = 1 AND date BETWEEN :from AND :to AND patientId = :patientId
  UNION ALL
  SELECT dateAdministered, patientId, 'VACCINATION' FROM Vaccination WHERE isActive = 1 AND dateAdministered BETWEEN :from AND :to AND patientId = :patientId
  UNION ALL
  SELECT date, patientId, 'WEIGHT' FROM Weight WHERE isActive = 1 AND date BETWEEN :from AND :to AND patientId = :patientId
  UNION ALL
  SELECT date, patientId, 'EMBRYO_TRANSFER' FROM EmbryoTransfer WHERE isActive = 1 AND date BETWEEN :from AND :to AND patientId = :patientId
  UNION ALL
  SELECT date, patientId, 'ICSI' FROM Icsi WHERE isActive = 1 AND date BETWEEN :from AND :to AND patientId = :patientId
)
SELECT activityDate AS date, activity_rows.patientId AS patientId, recordType AS recordTypeWireName, COUNT(*) AS cnt
FROM activity_rows
JOIN Patient ON Patient.id = activity_rows.patientId
WHERE Patient.isActive = 1
GROUP BY activityDate, activity_rows.patientId, recordType;

-- Buckets: global (no patient predicate) — avoids OR IS NULL non-sargable pattern
selectActivityBucketsGlobal:
WITH activity_rows AS (
  SELECT date AS activityDate, patientId, 'CONSULTATION' AS recordType FROM Consultation WHERE isActive = 1 AND date BETWEEN :from AND :to
  UNION ALL
  SELECT date, patientId, 'DENTISTRY' FROM Dentistry WHERE isActive = 1 AND date BETWEEN :from AND :to
