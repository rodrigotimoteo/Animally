-- SQL Table --
CREATE TABLE FarrierVisit (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    patientId INTEGER NOT NULL,
    date TEXT NOT NULL,
    trimOrShoe TEXT,
    shoeType TEXT,
    findings TEXT,
    nextDueDate TEXT,
    farrier TEXT,
    notes TEXT,
    isActive INTEGER NOT NULL DEFAULT 1,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

-- CRUD Operations --
insert:
INSERT INTO FarrierVisit (id, patientId, date, trimOrShoe, shoeType, findings, nextDueDate, farrier, notes, isActive, createdAt, updatedAt)
VALUES (NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE FarrierVisit SET
    patientId = ?,
    date = ?,
    trimOrShoe = ?,
    shoeType = ?,
    findings = ?,
    nextDueDate = ?,
    farrier = ?,
    notes = ?,
    isActive = ?,
    updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM FarrierVisit WHERE id = ?;

selectById:
SELECT * FROM FarrierVisit WHERE id = ? AND isActive = 1;

selectByPatient:
SELECT * FROM FarrierVisit WHERE patientId = ? AND isActive = 1;

selectAll:
SELECT * FROM FarrierVisit WHERE isActive = 1;

setInactive:
UPDATE FarrierVisit SET isActive = 0, updatedAt = ? WHERE id = ?;